# ── Βάση (docs/10 §3) ─────────────────────────────────────────────
# Εφαρμογή (web + worker) — μέσω PgBouncer (transaction mode, 6432)
DATABASE_URL="postgresql://dgcomplete_app:PASSWORD@100.70.50.43:6432/DG_COMPLETE"
# Migrations / Prisma CLI — απευθείας στο 5432, χωρίς PgBouncer
DATABASE_URL_MIGRATOR="postgresql://dgcomplete_migrator:PASSWORD@100.70.50.43:5432/DG_COMPLETE"
# Pool του @prisma/adapter-pg ανά process (web 10, worker 5)
DB_POOL_MAX="10"

# ── Auth ─────────────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Κρυπτογράφηση — "k1:<openssl rand -base64 32>" (νέο κλειδί μπαίνει πρώτο για rotation)
DATA_ENCRYPTION_KEYS=""

# Πρώτος super admin (npm run seed:admin)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""

# ── Scheduler ────────────────────────────────────────────────────
# openssl rand -hex 32
CRON_SECRET=""
# production: on εκτός αν "off" · development: off εκτός αν "on"
# Οι εργασίες ορίζονται στο lib/jobs/registry.ts, ΟΧΙ στο Coolify
SCHEDULER=""

# ── Ουρές (pg-boss, χωρίς Redis — ADR-022) ───────────────────────
# Απευθείας στο 5432 (όχι PgBouncer): pg-boss + LISTEN/NOTIFY για live events
QUEUE_DATABASE_URL="postgresql://dgcomplete_app:PASSWORD@100.70.50.43:5432/DG_COMPLETE"
QUEUE_POOL_MAX="4"
WORKER_CONCURRENCY="8"
# Live assist: εσωτερικό WS του worker (μόνο ιδιωτικό δίκτυο)
WORKER_ASSIST_URL=""
ASSIST_SHARED_SECRET=""

# ── Αρχεία (Bunny) ───────────────────────────────────────────────
STORAGE_DRIVER="local"          # bunny | local
BUNNY_STORAGE_ZONE="dg-complete"
BUNNY_STORAGE_REGION=""         # κενό = Falkenstein, αλλιώς π.χ. "uk", "se"
BUNNY_STORAGE_ACCESS_KEY=""     # ΜΟΝΟ server/worker
BUNNY_PULLZONE_HOST=""          # π.χ. dg-complete-artifacts.b-cdn.net
BUNNY_TOKEN_KEY=""

# ── API / recorder ───────────────────────────────────────────────
API_KEY_PEPPER=""
# openssl rand -base64 32
RECORDER_JWT_SECRET=""
